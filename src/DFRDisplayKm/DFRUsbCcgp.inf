;
; DFRUsbCcgp.inf: Apple Touch Bar (iBridge) USB composite device
; Switches the device to its iBridge configuration so the display interface is exposed.
; Install this file BEFORE DFRDisplayKm.inf.
;

[Version]
Signature="$WINDOWS NT$"
Class=USBDevice
ClassGuid={88BAE032-5A81-49f0-BC3D-A4FF138216D6}
Provider=%ManufacturerName%
CatalogFile=DFRUsbCcgp.cat
DriverVer=

[Manufacturer]
%ManufacturerName%=Standard,NTamd64

[Standard.NTamd64]
%DFRUsbCcgp.CompDeviceName% = DFRUsbCcgp_Install, USB\VID_05AC&PID_8302
%DFRUsbCcgp.CompDeviceName% = DFRUsbCcgp_Install, USB\VID_05AC&PID_8600

[DFRUsbCcgp_Install]
Include=usb.inf
Needs=Composite.Dev.NT

[DFRUsbCcgp_Install.Services]
Include=usb.inf
Needs=Composite.Dev.NT.Services

[DFRUsbCcgp_Install.HW]
AddReg=CompositeDev_AddReg

[CompositeDev_AddReg]
HKR,,FriendlyName,,%DFRUsbCcgp.CompDeviceName%
; Switch to the macOS iBridge display configuration
HKR,,OriginalConfigurationValue,%REG_DWORD%,1

[Strings]
ManufacturerName="Bingxing Wang"
DFRUsbCcgp.CompDeviceName="iBridge Display Composition Device"

REG_DWORD = 0x00010001
